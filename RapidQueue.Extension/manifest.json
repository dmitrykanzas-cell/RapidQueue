{
  "manifest_version": 3,
  "name": "RapidQueue",
  "version": "0.1.0",
  "description": "Automated queue downloader for Rapidgator and lossless-music.org",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "nativeMessaging",
    "scripting",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "RapidQueue",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://lossless-music.org/*", "*://rapidgator.net/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
